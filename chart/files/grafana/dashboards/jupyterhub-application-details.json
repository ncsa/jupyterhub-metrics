          "rawSql": "SELECT\n  us.user_email AS \"Email\",\n  COALESCE(u.full_name, us.user_email) AS \"Name\",\n  COUNT(*) AS \"Sessions\",\n  ROUND(SUM(CASE WHEN us.node_name LIKE '%gpu%' OR us.node_name LIKE '%a100%' OR us.node_name LIKE '%v100%' THEN us.runtime_hours ELSE 0 END)::numeric, 2) AS \"GPU\",\n  ROUND(SUM(CASE WHEN us.node_name NOT LIKE '%gpu%' AND us.node_name NOT LIKE '%a100%' AND us.node_name NOT LIKE '%v100%' THEN us.runtime_hours ELSE 0 END)::numeric, 2) AS \"CPU\",\n  ROUND(SUM(us.runtime_hours)::numeric, 2) AS \"Total\"\nFROM user_sessions us\nLEFT JOIN users u ON us.user_email = u.email\nWHERE\n  us.container_base = '$application'\n  AND us.session_start <= $__timeTo()\n  AND us.session_end >= $__timeFrom()\nGROUP BY us.user_email, u.full_name\nORDER BY \"Total\" DESC;",

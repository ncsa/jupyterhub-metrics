      "targets": [
        {
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH hourly AS (\n  SELECT\n    node_name,\n    time_bucket('1 hour', timestamp) AS hour,\n    COUNT(DISTINCT user_email) AS user_count\n  FROM container_observations\n  WHERE timestamp >= $__timeFrom()\n    AND timestamp <= $__timeTo()\n  GROUP BY node_name, hour\n),\ncurrent_state AS (\n  SELECT\n    node_name,\n    COUNT(DISTINCT user_email) AS current_users\n  FROM container_observations\n  WHERE timestamp >= NOW() - INTERVAL '15 minutes'\n  GROUP BY node_name\n)\nSELECT\n  REPLACE(h.node_name, 'cori-prod-worker-', '') AS \"Node\",\n  CASE WHEN (h.node_name ILIKE '%v100%' OR h.node_name ILIKE '%a100%' OR h.node_name ILIKE '%h100%' OR h.node_name ILIKE '%h200%') THEN 'GPU' ELSE 'CPU' END AS \"Type\",\n  MIN(h.user_count) AS \"Min\",\n  MAX(h.user_count) AS \"Max\",\n  COALESCE(cs.current_users, 0) AS \"Last\"\nFROM hourly h\nLEFT JOIN current_state cs ON h.node_name = cs.node_name\nGROUP BY h.node_name, cs.current_users\nORDER BY h.node_name;",
          "refId": "A"
        }
      ],
      "title": "Node Activity",
      "type": "table"
